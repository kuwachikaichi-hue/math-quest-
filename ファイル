<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>MATHQUEST Ω MOBILE FINAL</title>
<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
-webkit-tap-highlight-color:transparent;
}
body{
overflow:hidden;
background:#03040a;
font-family:Courier New,monospace;
cursor:none;
touch-action:none;
}
canvas{
display:block;
}
#ui{
position:fixed;
bottom:8px;
left:50%;
transform:translateX(-50%);
display:flex;
gap:6px;
z-index:100;
pointer-events:none;
}
.panel{
width:120px;
padding:6px;
border-radius:12px;
background:rgba(0,0,0,0.45);
backdrop-filter:blur(10px);
border:1px solid rgba(255,255,255,0.08);
}
.stat{
font-size:11px;
font-weight:bold;
margin-bottom:4px;
color:white;
}
.small{
font-size:9px;
opacity:.8;
margin-bottom:3px;
color:white;
}
.bar{
width:100%;
height:6px;
background:#111827;
border-radius:999px;
overflow:hidden;
}
.fill{
height:100%;
border-radius:999px;
}
#hpFill{
background:linear-gradient(90deg,#00ffaa,#00ddff);
}
#xpFill{
background:linear-gradient(90deg,#ffe066,#ff8c42);
}
#skillBox{
position:fixed;
right:16px;
bottom:120px;
display:flex;
flex-direction:column;
gap:10px;
z-index:200;
}
.skill{
width:60px;
height:60px;
border-radius:18px;
background:rgba(0,0,0,0.55);
border:1px solid rgba(255,255,255,0.1);
display:flex;
align-items:center;
justify-content:center;
font-size:22px;
color:white;
box-shadow:0 0 20px rgba(0,255,170,0.15);
}
#joystick{
position:fixed;
left:30px;
bottom:90px;
width:120px;
height:120px;
border-radius:50%;
background:rgba(255,255,255,0.05);
border:2px solid rgba(255,255,255,0.08);
z-index:300;
}
#stick{
position:absolute;
left:50%;
top:50%;
width:55px;
height:55px;
transform:translate(-50%,-50%);
border-radius:50%;
background:rgba(0,255,170,0.85);
box-shadow:0 0 25px #00ffaa;
}
#warning{
position:fixed;
top:50%;
left:50%;
transform:translate(-50%,-50%);
font-size:60px;
font-weight:bold;
color:red;
display:none;
z-index:999;
text-shadow:0 0 30px red;
animation:flash .5s infinite;
}
@keyframes flash{
0%{opacity:1;}
50%{opacity:.2;}
100%{opacity:1;}
}
#upgradeScreen{
position:fixed;
inset:0;
background:rgba(0,0,0,0.82);
display:none;
justify-content:center;
align-items:center;
flex-direction:column;
z-index:9999;
backdrop-filter:blur(12px);
}
#upgradeScreen h1{
font-size:50px;
color:#00ffaa;
margin-bottom:20px;
text-shadow:0 0 30px #00ffaa;
}
#upgradeCards{
display:flex;
flex-direction:column;
gap:14px;
width:90%;
max-width:340px;
}
.upgradeCard{
padding:18px;
border-radius:18px;
background:rgba(0,0,0,0.7);
border:2px solid rgba(255,255,255,0.08);
}
.upgradeCard h2{
font-size:24px;
margin-bottom:8px;
color:#00ffaa;
}
.upgradeCard p{
font-size:13px;
color:white;
opacity:.8;
}
#gameover{
position:fixed;
inset:0;
background:rgba(0,0,0,0.92);
display:none;
justify-content:center;
align-items:center;
flex-direction:column;
z-index:99999;
color:white;
}
button{
margin-top:20px;
padding:14px 36px;
font-size:20px;
border:none;
border-radius:12px;
background:#00ffaa;
font-weight:bold;
}
</style>
</head>
<body>
<div id="warning">BOSS WARNING</div>
<div id="upgradeScreen">
<h1>LEVEL UP</h1>
<div id="upgradeCards">
<div class="upgradeCard" onclick="pickUpgrade('damage')">
<h2>π DAMAGE</h2>
<p>数字ダメージ +35%</p>
</div>
<div class="upgradeCard" onclick="pickUpgrade('speed')">
<h2>SPEED</h2>
<p>移動速度アップ</p>
</div>
<div class="upgradeCard" onclick="pickUpgrade('rows')">
<h2>π ROWS</h2>
<p>弾列 +1</p>
</div>
<div class="upgradeCard" onclick="pickUpgrade('rapid')">
<h2>RAPID FIRE</h2>
<p>攻撃速度UP</p>
</div>
</div>
</div>
<canvas id="game"></canvas>
<script>
console.log('MATHQUEST Ω MOBILE COMPLETE FINAL');
</script>
</body>
</html>
